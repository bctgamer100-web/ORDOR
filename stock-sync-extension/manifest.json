{
  "manifest_version": 3,
  "name": "ส่งสต็อก BigSeller เข้า ORDER",
  "version": "0.14.0",
  "description": "ส่งออกสต็อก/ตำแหน่งจาก BigSeller แล้วนำเข้าตาราง op_stock ของ ORDER Workspace ด้วยเงื่อนไขเดียวกับหน้านำเข้าข้อมูล",
  "permissions": ["downloads", "storage", "unlimitedStorage", "tabs", "debugger", "scripting", "alarms"],
  "host_permissions": [
    "https://*.bigseller.com/*",
    "https://*.myqcloud.com/*",
    "https://yvfqxlgkwaylivopctno.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.bigseller.com/*"],
      "js": ["mainworld.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.bigseller.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bctgamer100-web.github.io/ORDER/*", "https://bctgamer100-web.github.io/ORDOR/*", "http://localhost/*", "file:///*"],
      "js": ["pagebridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "ส่งสต็อก BigSeller เข้า ORDER" }
}
